---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { SITE, CATEGORIES } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const posts = (await getPublishedPosts()).filter((p) => p.data.category === cat.slug);
const featured = posts.filter((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);
const url = new URL(`/category/${cat.slug}/`, Astro.site).href;
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': url,
    url,
    name: cat.name,
    description: cat.description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: cat.name,
    ...(posts.length
      ? {
          mainEntity: {
            '@type': 'ItemList',
            itemListElement: [...featured, ...rest].map((p, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              url: new URL(`/${p.id}/`, SITE.url).href,
              name: p.data.title,
            })),
          },
        }
      : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: cat.name, item: url },
    ],
  },
];
---
<Base title={`${cat.name}: articles and guides | ${SITE.name}`} description={cat.description} schema={schema} image={`/og/category-${cat.slug}.png`}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Topic</p>
      <h1>{cat.name}</h1>
      <p class="lede">{cat.description}</p>
    </div>
  </section>
  <div class="wrap">
    {featured.length > 0 && (
      <section class="start-here">
        <h2 class="section-title">Start here</h2>
        <PostList posts={featured} showCategory={false} />
      </section>
    )}
    {rest.length > 0 && featured.length > 0 && <h2 class="section-title">All briefs</h2>}
    {rest.length ? <PostList posts={rest} showCategory={false} /> : featured.length === 0 && <p class="empty">Briefs on {cat.name.toLowerCase()} are coming soon.</p>}
  </div>
</Base>
