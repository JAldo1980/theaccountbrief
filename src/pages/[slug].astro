---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE, AUTHOR, categoryBySlug } from '../consts';
import { getPublishedPosts, formatDate, readingTime, type Post } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props as { post: Post; all: Post[] };
const { Content } = await render(post);
const d = post.data;
const cat = categoryBySlug(d.category);
const url = new URL(`/${post.id}/`, Astro.site).href;
const related = all.filter((p) => p.id !== post.id && p.data.category === d.category).slice(0, 3);

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: d.title,
    description: d.description,
    url,
    mainEntityOfPage: url,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    inLanguage: SITE.lang,
    articleSection: cat.name,
    ...(d.focusKeyword || d.tags.length ? { keywords: [d.focusKeyword, ...d.tags].filter(Boolean).join(', ') } : {}),
    author: { '@id': `${SITE.url}/#james` },
    publisher: { '@id': `${SITE.url}/#james` },
    isPartOf: { '@id': `${SITE.url}/#website` },
    wordCount: (post.body ?? '').trim().split(/\s+/).length,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/category/${cat.slug}/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base
  title={`${d.metaTitle ?? d.title} | ${SITE.name}`}
  description={d.description}
  type="article"
  schema={schema}
  noindex={d.draft}
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate}
>
  <article>
    <header class="article-head narrow">
      <p class="breadcrumbs"><a href="/">Home</a> / <a href={`/category/${cat.slug}/`}>{cat.name}</a></p>
      <h1>{d.title}</h1>
      <p class="meta">
        By <a href="/about/">{AUTHOR.name}</a>{' · '}<time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>{d.updatedDate && <>{' · Updated '}<time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></>}{` · ${readingTime(post.body)} min read`}
      </p>
    </header>
    <div class="prose narrow">
      <Content />
    </div>
    <aside class="author-box narrow" aria-label="About the author">
      <span class="brand-mark" aria-hidden="true">JA</span>
      <div>
        <strong>{AUTHOR.name}</strong>
        <p>12+ years in B2B marketing, SEO and agency account management. Writes The Account Brief on strategy and client service. <a href="/about/">More about James</a>.</p>
      </div>
    </aside>
  </article>
  {related.length > 0 && (
    <section class="narrow related">
      <h2 class="section-title">More on {cat.name}</h2>
      <PostList posts={related} headingLevel="h3" showCategory={false} />
    </section>
  )}
</Base>
